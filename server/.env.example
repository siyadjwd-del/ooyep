# ---------------------------------------------------------------------------
# Sit Invest portal backend — environment configuration
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Microsoft SQL Server connection (the database you manage in SSMS)
SQL_SERVER=localhost            # e.g. localhost\SQLEXPRESS or your-host.database.windows.net
SQL_PORT=1433
SQL_DATABASE=SitInvest
SQL_USER=portal_app             # a least-privilege, read-mostly SQL login
SQL_PASSWORD=change-me

# TLS: true for Azure SQL / production. For a local dev SQL Server you may
# need SQL_ENCRYPT=false and SQL_TRUST_CERT=true.
SQL_ENCRYPT=true
SQL_TRUST_CERT=false

# API server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth — used to sign the JWT returned at login. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret
